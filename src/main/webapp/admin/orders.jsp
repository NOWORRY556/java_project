<%@ page contentType="text/html;charset=UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<html><head><title>Admin Orders</title></head><body><h1>Order Management</h1><p><a href="${pageContext.request.contextPath}/admin/dashboard">Dashboard</a></p><table border="1"><tr><th>ID</th><th>Customer</th><th>Total</th><th>Payment</th><th>Status</th><th>Created</th><th>Update</th></tr><c:forEach var="o" items="${orders}"><tr><td>${o.orderId}</td><td>${o.name}<br/>${o.email}</td><td>${o.total}</td><td>${o.paymentMethod}/${o.paymentStatus}</td><td>${o.orderStatus}</td><td>${o.createdAt}</td><td><form method="post">
    <input type="hidden" name="_csrf" value="${csrfToken}" /><input type="hidden" name="orderId" value="${o.orderId}"/><select name="status"><option>PLACED</option><option>PROCESSING</option><option>CONFIRMED</option><option>SHIPPED</option><option>DELIVERED</option><option>CANCELLED</option></select><button type="submit">Update</button></form></td></tr></c:forEach></table></body></html>