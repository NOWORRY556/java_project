<%@ page contentType="text/html;charset=UTF-8" %><%@ page import="java.util.*" %><!doctype html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Orders — ShopSphere</title><link rel="stylesheet" href="${pageContext.request.contextPath}/assets/css/app.css"></head><body><nav class="nav"><div class="container nav-inner"><a class="brand" href="${pageContext.request.contextPath}/">Shop<span>Sphere</span></a><a class="btn ghost" href="${pageContext.request.contextPath}/products">Continue shopping</a></div></nav><main class="container section"><div class="section-head"><div><span class="eyebrow">ACCOUNT</span><h2>My orders</h2><p class="muted">Track your recent purchases and payment status.</p></div></div><div class="table-wrap"><table><tr><th>Order</th><th>Total</th><th>Payment</th><th>Payment status</th><th>Order status</th><th>Date</th><th>Details</th></tr><% List<Map<String,Object>> orders=(List<Map<String,Object>>)request.getAttribute("orders"); if(orders==null||orders.isEmpty()){ %><tr><td colspan="7" class="empty">No orders yet.</td></tr><% } else { for(Map<String,Object> o:orders){ %><tr><td><strong>#<%=o.get("orderId")%></strong></td><td>₹<%=o.get("total")%></td><td><span class="chip"><%=o.get("paymentMethod")%></span></td><td><span class="chip success"><%=o.get("paymentStatus")%></span></td><td><span class="chip"><%=o.get("orderStatus")%></span></td><td class="muted"><%=o.get("createdAt")%></td><td><a class="button secondary" href="<%=request.getContextPath()%>/order-detail?orderId=<%=o.get("orderId")%>">View</a></td></tr><% }} %></table></div></main></body></html>